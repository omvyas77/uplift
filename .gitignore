.venv/
.venv-*/
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Data: NEVER commit. Ship the download script instead.
#
# These patterns are ANCHORED with a leading slash so they match only the
# top-level directories they mean. An unanchored `data/` matches a directory of
# that name at ANY depth - which silently excluded the entire src/uplift/data/
# package from the repo and made a fresh clone unrunnable.
/data/
/artifacts/
*.duckdb
*.duckdb.wal
*.csv
*.csv.gz
*.parquet
!dbt/seeds/criteo_sample.csv

# dbt
/dbt/target/
/dbt/dbt_packages/
/dbt/logs/
.user.yml

/models/*.pkl
/models/*.joblib
!/models/.gitkeep

.env
.DS_Store
.ipynb_checkpoints/

# Personal working notes, not project artifacts. These are the PLAN the project
# was built from, plus study material written around it. A reader of the repo
# should see the work, not the recipe. Kept on disk, out of the repo.
/UPLIFT_BUILD_GUIDE.md
/AB_TESTING_STUDY_GUIDE.md
